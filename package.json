{
  "name": "fretlab",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "check": "tsx src/core/music/music.check.ts && tsx src/core/audio/audio.check.ts && tsx src/features/fretboard/geometry.check.ts && tsx src/features/picker/search.check.ts && tsx src/features/study/logic.check.ts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@preact/preset-vite": "^2.10.0",
    "@types/node": "^24.19.2",
    "oxlint": "^1.93.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.0",
    "vite": "^7.3.8",
    "vite-plugin-pwa": "^1.3.0"
  },
  "engines": {
    "node": ">=22"
  }
}
